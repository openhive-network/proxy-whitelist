# Settings of replica/compose.yml. Copy to replica/.env and edit.

# The primary's API base (its URL rewriter), reachable from this host.
PROXY_WHITELIST_SOURCE_URL=http://10.10.10.8/proxy-whitelist-api

# Passwords (URL-safe characters only: they are embedded in connection URLs).
# REPLICA_DB_PASSWORD is the replica Postgres superuser's (the installer and the
# syncer); REPLICA_API_PASSWORD is proxy_whitelist_user's (PostgREST).
REPLICA_DB_PASSWORD=change-me
REPLICA_API_PASSWORD=change-me-too

# Where the API (the rewriter: /whitelist/check, /avatar/{name}, /sync-status, ...)
# and PostgREST's admin server (/live, /ready) listen on the host.
REPLICA_HTTP_BIND=127.0.0.1:7010
REPLICA_POSTGREST_ADMIN_BIND=127.0.0.1:3001
# The haproxy agent-check port (replica-agent) and the replica database's
# loopback port (for an agent run on the host instead).
REPLICA_AGENT_BIND=127.0.0.1:7015
REPLICA_DB_PORT=5433

# Seconds between sync cycles, and the page_size of each stream request (at most
# 100000; a page the source path answers with 502/504 or a timeout is retried
# with half the size, down to 1000).
POLL_INTERVAL_S=5
PAGE_LIMIT=100000

# 1: when the primary's sync_uuid or stream_schema_version changes, truncate the
# replica and bootstrap again instead of waiting for the old identity to return.
PROXY_WHITELIST_REPLICA_RESET=0

# 1: truncate the replica and bootstrap again once, at the next start of
# replica-sync. Honoured once: later restarts with it still 1 do not rebuild
# again; set it back to 0 (and restart) before using it again.
PROXY_WHITELIST_REPLICA_REBUILD=0

# Cloudflare invalidation of the imagehoster's avatar/cover redirects after a
# profile change (replica/README.md, Cache invalidation). Off unless all three
# are set; set them on one replica per zone only. The token needs Zone.Cache Purge.
#PURGE_CLOUDFLARE_ZONE=
#PURGE_CLOUDFLARE_TOKEN=
#PURGE_BASE_URL=https://images.hive.blog
# Comma-separated, with {base} and {name}; default: the 10 avatar/cover URLs of cf-cache-purger.
#PURGE_URL_TEMPLATES=
# Seconds per drain in which new purge calls (30 URLs each) are started.
#PURGE_TIME_BUDGET_S=5

# Images (default: the latest published ones).
#PROXY_WHITELIST_IMAGE=registry.gitlab.syncad.com/hive/proxy-whitelist:latest
#PROXY_WHITELIST_REWRITER_IMAGE=registry.gitlab.syncad.com/hive/proxy-whitelist/postgrest-rewriter:latest
#POSTGREST_IMAGE=postgrest/postgrest:v12.0.2
#REPLICA_POSTGRES_IMAGE=postgres:18
